record(ai, "$(IOCNAME):#UsedFDs") {
    field(DESC, "Allocated File Descriptors")
    field(SCAN, "I/O Intr")
    field(DTYP, "IOC stats")
    field(FLNK, "$(IOCNAME):#FD_FREE  PP MS")
    field(INP,  "@fd")
}

record(calc, "$(IOCNAME):#AvailableFDs") {
    field(DESC, "Available FDs")
    field(CALC, "B>0?B-A:C")
    field(INPA, "$(IOCNAME):#UsedFDs  NPP MS")
    field(INPB, "$(IOCNAME):#MaxNumberFDs  NPP MS")
    field(INPC, "1000")
    field(HOPR, "150")
    field(LOLO, "5")
    field(LOW,  "20")
    field(LLSV, "MAJOR")
    field(LSV,  "MINOR")

    info(autosaveFields_pass0, "HOPR LOPR LOW LOLO LSV LLSV")
}

