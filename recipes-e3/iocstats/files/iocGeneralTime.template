record(ai, "$(IOCNAME):#GenTimeTime") {
    field(DESC, "Gen Time Secs since 1990")
    field(SCAN, "1 second")
    field(DTYP, "General Time")
    field(PREC, "3")
    field(INP,  "@TIME")
    field(EGU,  "sec")
}

record(bo, "$(IOCNAME):#GenTimeErrReset") {
    field(DESC, "Gen Time Error Reset")
    field(DTYP, "General Time")
    field(OUT,  "@RSTERRCNT")
    field(ZNAM, "Reset")
    field(ONAM, "Reset")
}

record(longin, "$(IOCNAME):#GenTimeErrCount") {
